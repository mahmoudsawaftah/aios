# The Obsidian vault is a junction - it is NOT part of this repo
vault/

# Projects are their own repositories - tracked by projects/INDEX.md, not by this repo
projects/*
!projects/_template/
!projects/README.md
!projects/INDEX.md

# Secrets - never
.env
**/.env
*.pem
*.key

# ECC generated files are installed, not authored here
.claude/
.agents/
!.agents/skills/
.agents/skills/*
!.agents/skills/aios-*/
!.agents/skills/aios-*/SKILL.md

# Volatile
raw/scratch/
raw/query-output/
comms/
node_modules/
__pycache__/
.venv/
.DS_Store
Thumbs.db
